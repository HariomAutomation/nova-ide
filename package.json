{
  "name": "nova-ide",
  "productName": "Nova IDE",
  "version": "0.2.0",
  "private": true,
  "description": "A Cursor-like AI IDE with your own API keys and full model choice",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build --config renderer/vite.config.mjs",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "start": "npm run build && electron . --no-sandbox",
    "app": "electron . --no-sandbox",
    "mock:llm": "node scripts/mock-llm.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "test:sanity": "node scripts/test-sanity.mjs",
    "test:smoke": "node scripts/test-flow.mjs",
    "test:all": "node scripts/test-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "vite": "^8.3.4"
  }
}
