{
  "name": "nova-ide",
  "productName": "Nova IDE",
  "version": "0.2.0",
  "private": true,
  "description": "Nova IDE - The autonomous AI IDE with your own API keys and full model choice",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json --noCheck true",
    "build:renderer": "vite build --config renderer/vite.config.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "start": "npm run build && electron . --no-sandbox --log-level=3",
    "app": "npm run build && electron . --no-sandbox --log-level=3",
    "mock:llm": "node scripts/mock-llm.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "test:agent": "node scripts/test-agent.mjs",
    "test:regression": "npm run build:electron && node scripts/test-regression.mjs",
    "test:sanity": "node scripts/test-sanity.mjs",
    "test:smoke": "node scripts/test-flow.mjs",
    "test:headless": "npm run build:electron && node scripts/test-headless.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:e2e": "playwright test",
    "typecheck:electron": "node scripts/typecheck-electron.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:electron",
    "test": "npm run build:electron && node scripts/test-regression.mjs && node scripts/test-headless.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
